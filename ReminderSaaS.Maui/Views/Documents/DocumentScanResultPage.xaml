<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Document Analysis"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}"
             x:Class="ReminderSaaS.Maui.Views.Documents.DocumentScanResultPage">

    <Grid RowDefinitions="*,Auto" RowSpacing="0" Margin="0">
        <!-- Content -->
        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="16">
                <!-- Initial Camera Button -->
                <VerticalStackLayout 
                    IsVisible="{Binding ShowResult, Converter={StaticResource InvertedBoolConverter}}"
                    Spacing="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Label Text="📷" FontSize="72" HorizontalTextAlignment="Center" />
                    <Label Text="Scan Document" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Tap below to open your camera and scan a document" FontSize="14" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
                    <Button 
                        Text="Open Camera"
                        Command="{Binding ScanDocumentCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,20,0,0" />
                </VerticalStackLayout>

                <!-- Loading Indicator -->
                <ActivityIndicator 
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    Color="#512BD4"
                    Scale="1.5" />

                <!-- Summary Section -->
                <VerticalStackLayout IsVisible="{Binding ShowResult, Converter={StaticResource InvertedBoolConverter}}" Spacing="8">
                    <Label Text="Document Summary" FontSize="18" FontAttributes="Bold" />
                    <Label 
                        Text="{Binding Summary}"
                        FontSize="14"
                        LineBreakMode="WordWrap"
                        TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" />
                </VerticalStackLayout>

                <!-- Appointment Section -->
                <Border
                    IsVisible="{Binding ShowResult}"
                    Padding="12"
                    Margin="0,0,0,12"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                    StrokeShape="RoundRectangle 12,12,12,12"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Summary}" FontSize="16" FontAttributes="Bold" />
                        
                        <!-- If Appointment Found -->
                        <VerticalStackLayout IsVisible="{Binding ContainsAppointment}" Spacing="12">
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" />
                            
                            <Label Text="📅 Appointment Details" FontSize="14" FontAttributes="Bold" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Title:" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding AppointmentTitle}" FontSize="12" Grid.Column="1" LineBreakMode="WordWrap" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Date:" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding AppointmentDate, StringFormat='{0:ddd, MMM dd, yyyy}'}" FontSize="12" Grid.Column="1" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Time:" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding AppointmentTime, StringFormat='{0:HH:mm}'}" FontSize="12" Grid.Column="1" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding AppointmentLocation, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="Location:" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding AppointmentLocation}" FontSize="12" Grid.Column="1" LineBreakMode="WordWrap" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="Category:" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding AppointmentCategory}" FontSize="12" Grid.Column="1" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- If No Appointment -->
                        <Label 
                            Text="No appointment detected in this document."
                            IsVisible="{Binding ContainsAppointment, Converter={StaticResource InvertedBoolConverter}}"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#999999}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Error Message -->
                <Label 
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                    TextColor="Red"
                    FontSize="12"
                    LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Padding="16">
            <Button 
                Text="Close"
                Command="{Binding CloseResultCommand}"
                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                CornerRadius="8"
                Grid.Column="0" />

            <Button 
                Text="Confirm"
                Command="{Binding ConfirmAppointmentCommand}"
                IsVisible="{Binding ContainsAppointment}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="8"
                Grid.Column="1" />
        </Grid>
    </Grid>
</ContentPage>
