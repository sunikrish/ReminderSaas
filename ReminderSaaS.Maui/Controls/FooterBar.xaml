<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ReminderSaaS.Maui.Controls.FooterBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="12,8,12,12"
        Padding="0"
        StrokeShape="RoundRectangle 28,28,28,28"
        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1F1F1F}"
        Stroke="{AppThemeBinding Light=#EFEFEF, Dark=#2A2A2A}"
        StrokeThickness="1"
        Shadow="Offset: 0,4 Blur: 12 Color: #00000020"
        HeightRequest="70">

        <Grid ColumnDefinitions="*, *, *" Padding="16" RowSpacing="0" ColumnSpacing="0">
            <!-- Camera Icon Button (Left) -->
            <Button
                x:Name="CameraButton"
                Grid.Column="0"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                CornerRadius="24"
                HeightRequest="48"
                Padding="0"
                WidthRequest="48"
                FontSize="32"
                Text="📷"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                SemanticProperties.Description="Camera" />

            <!-- Add Schedule Icon Button (Center) -->
            <Button
                x:Name="AddButton"
                Grid.Column="1"
                BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#ac99ea}"
                BorderColor="Transparent"
                CornerRadius="24"
                HeightRequest="48"
                Padding="0"
                WidthRequest="48"
                FontSize="32"
                FontAttributes="Bold"
                Text="+"
                TextColor="{AppThemeBinding Light=White, Dark=#242424}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                SemanticProperties.Description="Add Schedule" />

            <!-- Voice Icon Button (Right) -->
            <Button
                x:Name="VoiceButton"
                Grid.Column="2"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                CornerRadius="24"
                HeightRequest="48"
                Padding="0"
                WidthRequest="48"
                FontSize="32"
                Text="🔊"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                SemanticProperties.Description="Voice" />
        </Grid>
    </Border>

</ContentView>
